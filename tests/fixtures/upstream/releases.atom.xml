&lt;li&gt;Plugin-catalog): bump aux-ledger to 1.4.0 (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/6048066e22f3019505d04caeab29577c803f4d71&quot;&gt;&lt;code&gt;6048066e&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/olric3015/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/olric3015&quot;&gt;@olric3015&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Plugin-catalog): add the wait-ledger catalog card (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/77cb58e56ac47d5e3aa1ee720d4bcd7a8c6a8513&quot;&gt;&lt;code&gt;77cb58e5&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/olric3015/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/olric3015&quot;&gt;@olric3015&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Plugin-catalog): add wait-ledger (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/97e65322efebd1b8dc07d33634b685df078d5858&quot;&gt;&lt;code&gt;97e65322&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/olric3015/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/olric3015&quot;&gt;@olric3015&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Community plugin: lightningai + lightningai-rate-limit (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/075154660043fe5656ec3ca48c93d6a6f9755494&quot;&gt;&lt;code&gt;07515466&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/dinosauria123/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/dinosauria123&quot;&gt;@dinosauria123&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Catalog: add Hermes AAC 0.1.0 at reviewed exact source pin (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/7c9adda81a2d152ba4f63fe6aecf59385dfc3284&quot;&gt;&lt;code&gt;7c9adda8&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/TREE-Ind/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/TREE-Ind&quot;&gt;@TREE-Ind&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Plugin-catalog): add openinvest (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/b6e86101c29593785c81eb8d380e2faef2530d5f&quot;&gt;&lt;code&gt;b6e86101&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/longsizhuo/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/longsizhuo&quot;&gt;@longsizhuo&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Catalog: add hermes-agent-mixer (v0.2.0 @ 04c4e13) (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/2e7e385959dc65ceb3053724724d8a5f526c675d&quot;&gt;&lt;code&gt;2e7e3859&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/Sahil-SS9/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/Sahil-SS9&quot;&gt;@Sahil-SS9&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Plugins): move Kumiho Memory to memory catalog shelf (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/46f95e086379a2d701595b981cb94733fd060384&quot;&gt;&lt;code&gt;46f95e08&lt;/code&gt;&lt;/a&gt;) — &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/kaveone/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/kaveone&quot;&gt;@kaveone&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Add canonical group attachment controls (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/4673f17c9aa5e5cfe48a68830e3ed352af11e0a6&quot;&gt;&lt;code&gt;4673f17c&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Consume event-bound hosted files through canonical admissions (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/e87bd098eab1a24f97802fe783596bd91f81fc5b&quot;&gt;&lt;code&gt;e87bd098&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Connect Desktop groups to canonical driver controls (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/3c2c9d470a7ade1a5f47d202a2d1d24abc608f95&quot;&gt;&lt;code&gt;3c2c9d47&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Transport hosted producers through authenticated owner sockets (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/51189b05330b2eee1de148f4f83d3a5f34baa54a&quot;&gt;&lt;code&gt;51189b05&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Retain hosted room work evidence across authority changes (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/0af2c714542d055047aa7529d896ee528e80ccdf&quot;&gt;&lt;code&gt;0af2c714&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Route hosted room workers through session authority (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/bd22e0f9c467f8a68ee24656c49c7c28c7967954&quot;&gt;&lt;code&gt;bd22e0f9&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Wire canonical hosted group controls (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/fa2179bb8c3bc263559bbfdfe32ac0d3ffe9a6ec&quot;&gt;&lt;code&gt;fa2179bb&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Gateway): resolve --resume &amp;lt;title&amp;gt; and -c &amp;lt;title&amp;gt; [--create-if-missing] in the authority (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/11a83ad4d19fab4bd8889c9d04759af168c55b2b&quot;&gt;&lt;code&gt;11a83ad4&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Retain terminal identity tombstones during history retirement (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/ba435291aab7d782e70f1102bd6174d9b6278675&quot;&gt;&lt;code&gt;ba435291&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Route native CLI and ACP actions through prepared controls (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/27b0f7f20a7ba0fdc793fafe732d56adf2dfa54f&quot;&gt;&lt;code&gt;27b0f7f2&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Publish real prepared compression in the mutation receipt transaction (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/b654027693d6c8f92b185e8a3bd2728c5f3e81c5&quot;&gt;&lt;code&gt;b6540276&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Prepare and atomically publish local model changes (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/7e7fa7c61611a858cc0be51f790584b91f1d149c&quot;&gt;&lt;code&gt;7e7fa7c6&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Commit independent local branch policy and route atomically (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/f98eaec108f365da07090495a82d6ca95c2de66a&quot;&gt;&lt;code&gt;f98eaec1&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Project managed tool progress without private arguments or results (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/61ccd894c3674d01a2fb95528217816bc4888d52&quot;&gt;&lt;code&gt;61ccd894&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Bridge managed worker approvals clarification and stop (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/a0b5118f46196190bc244a8f1ecf17d5754fc72c&quot;&gt;&lt;code&gt;a0b5118f&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Launch admission-owned tool workers from the ordinary daemon (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/510e32be9a31a2caae358fc6c95673ffb24c0466&quot;&gt;&lt;code&gt;510e32be&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Enforce safe defaults at bare agent construction (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/1eeac867b187f331b61e1b607d35b1af7f00b2bc&quot;&gt;&lt;code&gt;1eeac867&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Suppress rules skills and memory readers in private safe workers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/25cda66a8bfff26da5c92bf3170cc724bd7fc5ec&quot;&gt;&lt;code&gt;25cda66a&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Bypass plugin providers and hook execution in safe workers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/33921e6f97a950b4b74ffa11cdb3004676f1c920&quot;&gt;&lt;code&gt;33921e6f&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Bind immutable private worker config before runtime imports (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/4cc3f42087e61e84a3b6054903e88f3c7e943a56&quot;&gt;&lt;code&gt;4cc3f420&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Expose verified canonical ACP editor MCP attachment (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/1bda56a104e55ebbd21fdefaed860f6488009b57&quot;&gt;&lt;code&gt;1bda56a1&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Rebind exact editor MCP credentials on canonical ACP resume (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/5bfa2f2c2df10d26f24c103079fd9044e69b4df8&quot;&gt;&lt;code&gt;5bfa2f2c&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Borrow editor MCP configurations with frozen session manifests (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/394f00f694cb90c2ea6f502eda0959bc37ab2830&quot;&gt;&lt;code&gt;394f00f6&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Isolate execution-owned MCP registry overlays (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/96e4d2962bfeb56323063f64bad8cca3fd4479ee&quot;&gt;&lt;code&gt;96e4d296&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Commit local reset targets with runtime mutation receipts (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/821137c301ebc5419f86a7069b66036b42100aab&quot;&gt;&lt;code&gt;821137c3&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Expose profile-scoped Bot relay mailbox RPCs on the authority (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/792aa35adc57874c62a6d03a40d512d0bab1cebe&quot;&gt;&lt;code&gt;792aa35a&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Migrate queued Bot mailbox identities without replaying claims (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/af49e2fc05950473e4ee6f9dd431233540f62923&quot;&gt;&lt;code&gt;af49e2fc&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Send local Bot DMs to the discovered canonical authority (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/47ba694e291d0d3233041720d04317f5cd82285f&quot;&gt;&lt;code&gt;47ba694e&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Admit identified Bot Chat relay deliveries through session authority (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/998df8cc0b8028634a6fca15677ab2fc20900b2a&quot;&gt;&lt;code&gt;998df8cc&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Reserve exact owner-started admission worker claims (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/fbdfd46de8303673c908207206a818d98f8d68f4&quot;&gt;&lt;code&gt;fbdfd46d&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Expose authenticated owner mutation snapshots (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/d6331c4813bab5d0d920286b4af5a6b58fd13ced&quot;&gt;&lt;code&gt;d6331c48&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Freeze ACP tool policy and bind execution-owned edit consent (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/e2f5cfc65ea6c38580d3ac38469e71bf31912354&quot;&gt;&lt;code&gt;e2f5cfc6&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Reserve hosted API identities through the authority (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/6b278ca4f015e2a5a5b0a30c5ac1b11825c15384&quot;&gt;&lt;code&gt;6b278ca4&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Admit API runs before acknowledging execution (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/f2d9cea38e97e0356b9b24c07ea5deddfe9de914&quot;&gt;&lt;code&gt;f2d9cea3&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Run bound API turns on the shared cached agent (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/dea4f0c568e6d0e13fd9ea8be73cd4ea81a96f25&quot;&gt;&lt;code&gt;dea4f0c5&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Restore server-bound API session identities (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/76532ae1338cc193f6bdef92c0aa4d616a319150&quot;&gt;&lt;code&gt;76532ae1&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Retain claim-fenced structured admission results (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/262e0ebf5ff0123d675098aaa5c8e03f5e4c5d1b&quot;&gt;&lt;code&gt;262e0ebf&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Compose worker compression lifecycle and delegation persistence (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/6c57ad37c31e643f5692ea5d31ab759b425cf113&quot;&gt;&lt;code&gt;6c57ad37&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Publish committed worker completions through authenticated owner bridge (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/d94ccc2d8182ed1a5da6a11b9d79a1d4b97a96c7&quot;&gt;&lt;code&gt;d94ccc2d&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fence delegation receipts with shared worker sequence and epoch (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/be85ca249e51ae9975c049604e1ae2ed4194261b&quot;&gt;&lt;code&gt;be85ca24&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Route registered worker delegation writes through durable outbox (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/1ee6545f7a34d4424d7dcae44b7e40c217cb4a0c&quot;&gt;&lt;code&gt;1ee6545f&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add execution-bound delegation ledger operations (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/8128e88fd2b7f86b16534c0f62b605265aee80af&quot;&gt;&lt;code&gt;8128e88f&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Persist worker titles activity and route sidecars with receipts (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/235e4f12d7d9212c205cf1f98876ea0e6fa0e12c&quot;&gt;&lt;code&gt;235e4f12&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add assignment-fenced worker constructor and finalization handlers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/b7de5a8eba9ab7c4851c823f8fd196f2c4ca5da8&quot;&gt;&lt;code&gt;b7de5a8e&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Atomically compact and advance worker transcript assignments (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/c2e77ebaeb77b0f70dce83c105606335a64cd988&quot;&gt;&lt;code&gt;c2e77eba&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Preserve worker history and cache lineage identities (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/e63e1101c02a80e6f3b9f0ca619fae5b6be73e6e&quot;&gt;&lt;code&gt;e63e1101&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add receipted worker compression guards and leases (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/d51afe4cb92e66e499c6e3f385dfbe18b8d9b88d&quot;&gt;&lt;code&gt;d51afe4c&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Route REST imports and deletion through mutation receipts (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/2cdd103df9f7b1668292c36e791fc5fd084860ff&quot;&gt;&lt;code&gt;2cdd103d&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Route REST sidebar edits through the shared authority (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/eb329d21ba95077eff9764e7531e3364ed3d8362&quot;&gt;&lt;code&gt;eb329d21&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Coordinate shared mutations and publish committed revisions (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/eb42a0021f05befde4159c43e097b652fc9d1cf3&quot;&gt;&lt;code&gt;eb42a002&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Reuse transactional rewind with generation and receipt fences (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/6777ffa4bb67310bc5a7044892cc7cf48bdb685e&quot;&gt;&lt;code&gt;6777ffa4&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Import session histories atomically with retry receipts (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/b919459524e609dd60cf04c5710941db8cce1903&quot;&gt;&lt;code&gt;b9194595&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fence destructive deletion without erasing runtime obligations (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/e5249c9af4efbcfd9aca39f276c71d938249c3e4&quot;&gt;&lt;code&gt;e5249c9a&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Commit sidebar edits with canonical mutation receipts (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/0b1b8e0f1d845060c84791f9bc45f581b9ed8858&quot;&gt;&lt;code&gt;0b1b8e0f&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Project execution-owned approvals to ACP viewers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/97a24c10b3b81a8ea1f142d0125b05ffc62098aa&quot;&gt;&lt;code&gt;97a24c10&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Attach ACP transport to canonical session execution (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/8dd92a30b6b53c9b5ae3a27eebcb90f36c9919a3&quot;&gt;&lt;code&gt;8dd92a30&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Persist assigned worker prompt context and usage anchors (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/c6540cb9dd86a08eef0bf597bcb9dae68a955ac3&quot;&gt;&lt;code&gt;c6540cb9&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Admit local automation through owner durable FIFO (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/1642b339918cb74f87b4d03e17593d547e674329&quot;&gt;&lt;code&gt;1642b339&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Queue due gateway heartbeat ticks through canonical admission (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/ab44af2c0732485fb33c7e53bad0a5daa29f8d28&quot;&gt;&lt;code&gt;ab44af2c&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Admit trusted gateway completions to the durable session FIFO (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/7cd1b000daa3526e72a817df70190dd5569e0aec&quot;&gt;&lt;code&gt;7cd1b000&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fence worker terminal receipt after sequenced durable writes (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/21a48aea09d719b3f2a1f2ebae8053791b6b13d2&quot;&gt;&lt;code&gt;21a48aea&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Authenticate live worker persistence and explicit restart adoption (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/9d7d7e2abdab2a59f7e7e0ff517b85b73de45681&quot;&gt;&lt;code&gt;9d7d7e2a&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Receipt worker main and auxiliary usage in canonical transactions (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/9d896c499b034fcb4e16e58a1865a26feb778ec0&quot;&gt;&lt;code&gt;9d896c49&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Atomically receipt structured worker transcripts and turn leases (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/2abe47de8bd8f2b9f76c024b339244e05e7918b0&quot;&gt;&lt;code&gt;2abe47de&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Dispatch bound local slash commands through gateway handlers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/b0377e929b48bed68fb13799ad1878d747e128e3&quot;&gt;&lt;code&gt;b0377e92&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Share authenticated canonical slash discovery with legacy catalogs (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/fcf50e03c3b2cdae9c160ee01f23ba576c198965&quot;&gt;&lt;code&gt;fcf50e03&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Authenticate native HTTP through private daemon grants (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/75764b2ad0c8767069da717f68a81977d1165409&quot;&gt;&lt;code&gt;75764b2a&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Commit local creation policy and restore cold authority routes (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/aa2624ba5c200d2e540e538e6bae73754f9f8f15&quot;&gt;&lt;code&gt;aa2624ba&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Attach Desktop local launches to canonical gateway (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/9c40ddcfc2a04fdb3278e8173a85a4b03c24099f&quot;&gt;&lt;code&gt;9c40ddcf&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Bind Ink sessions and controls to canonical authority envelopes (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/a2d9e258daa97b43836821a97f79c5de06d21df5&quot;&gt;&lt;code&gt;a2d9e258&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Attach Ink local transport through canonical gateway bootstrap (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/08f628f9f5b0f5a2ebcaf7ece45e76e3ff71f457&quot;&gt;&lt;code&gt;08f628f9&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Route normal classic and one-shot launch through the gateway (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/3551045907580e25a766d01bc56eb0ee41115d0d&quot;&gt;&lt;code&gt;35510459&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add transport-only classic gateway client and option validation (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/6ed03be97446425fbf47c64ea4c71a318f4f6ba5&quot;&gt;&lt;code&gt;6ed03be9&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Apply local launch policy through real gateway turns (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/080c5da6f201058cf7dfda6bc0343910dc1f6625&quot;&gt;&lt;code&gt;080c5da6&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Define frozen local session launch policy (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/81ed9712f29cacb8727e2c0cc12960a64201abf0&quot;&gt;&lt;code&gt;81ed9712&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Route revision-checked session metadata through gateway (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/17ddbe4407a60230c2bfb0b743fc44b8a027f1c4&quot;&gt;&lt;code&gt;17ddbe44&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Expose scoped local session metadata and document compatibility (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/52c354ff183ae96e2cbba651acda7e679b795db6&quot;&gt;&lt;code&gt;52c354ff&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Create gateway-owned local sessions through authenticated controls (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/42967cddd73f56da1f62ab91f945c36347bd932c&quot;&gt;&lt;code&gt;42967cdd&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Recheck native Discord membership before durable admission and claim (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/cc0cd5c993e51feaf6be61077e2a2566673847fc&quot;&gt;&lt;code&gt;cc0cd5c9&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Boot authenticated session authority in ordinary gateway (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/c3bf62ebd392e9d2f843b0f5b2f1020561c7baee&quot;&gt;&lt;code&gt;c3bf62eb&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Share live clarification controls across attached viewers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/9c474378a1f608cb388d50fdd5e3d5b173cbac89&quot;&gt;&lt;code&gt;9c474378&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Stream canonical gateway execution events to shared observers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/40d9b4c7ea8e755c886588523fa3b659137fe54a&quot;&gt;&lt;code&gt;40d9b4c7&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Reauthorize multiplex native connector provenance (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/244bff73c8cb4430b8041de6b14c87e5861f3c17&quot;&gt;&lt;code&gt;244bff73&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Share generation-fenced approvals across gateway viewers (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/5e2afdaec356a2999de82d67b556f02189516ede&quot;&gt;&lt;code&gt;5e2afdae&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Retain native media and context before durable admission (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/ef447482f23ec3c46c3e0f7dafd52e6693c14117&quot;&gt;&lt;code&gt;ef447482&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Replay authority events from atomic subscription watermarks (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/d24dc3fa6f55afc29eb8e56907c225cbc0288c01&quot;&gt;&lt;code&gt;d24dc3fa&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Recover committed native text without replaying unknown turns (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/78646003aeab0a086b81a580b3fd0eff80808e2a&quot;&gt;&lt;code&gt;78646003&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Execute attached websocket turns on the messaging live agent (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/47fbfd4ca545b84f7413c263cb1aa799d7e34bd3&quot;&gt;&lt;code&gt;47fbfd4c&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add revision-fenced runtime rename and archive receipts (&lt;a href=&quot;https://github.com/NousResearch/hermes-agent/commit/5878e5656ca6907168d957cc08eec8e7862f13b4&quot;&gt;&lt;code&gt;5878e565&lt;/code&gt;&lt;/a&gt;)&lt;/li&gt;&lt;/ul&gt;
