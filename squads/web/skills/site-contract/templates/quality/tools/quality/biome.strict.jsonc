{
  // The squad's strict rules. The project's own biome.json (from the stack's create CLI or `biome init`) extends
  // this file, so Biome's version and schema stay the installer's. Workers never relax it: a rule that blocks real
  // work goes to the manager.
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.next",
      "!!**/.astro",
      "!!**/.wrangler",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/public",
      "!!**/.hermes-live",
      "!!src/routeTree.gen.ts",
      "!!tools/quality/node_modules"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 10 }
        },
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 60 } },
        "useMaxParams": { "level": "error", "options": { "max": 3 } },
        "noUselessUndefinedInitialization": "error",
        // TypeScript's noPropertyAccessFromIndexSignature wants env["X"]: the stricter type rule wins
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noConsole": "error",
        "noImportCycles": "error",
        "noEvolvingTypes": "error",
        "noImplicitAnyLet": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 300 } },
        "noParameterAssign": "error",
        "useBlockStatements": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error",
        "noNamespaceImport": "error"
      }
    }
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" }
}
